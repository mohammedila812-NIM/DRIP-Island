<UserControl x:Class="IslandWin.MusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="22,0,30,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- album art; background is replaced with an ImageBrush when artwork is available -->
    <Border x:Name="Art" Width="128" Height="128" CornerRadius="18" Background="#2C2C2E" VerticalAlignment="Center"/>

    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
      <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="ArtistText" Text="Play something to see it here" FontSize="14" Foreground="#8E8E93"
                 TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>

      <Border x:Name="Track" Height="6" CornerRadius="3" Background="#2C2C2E" Margin="0,16,0,0"
              Cursor="Hand" MouseLeftButtonDown="OnSeek">
        <Border x:Name="Fill" Width="0" HorizontalAlignment="Left" CornerRadius="3" Background="White" IsHitTestVisible="False"/>
      </Border>
      <Grid Margin="0,5,0,0">
        <TextBlock x:Name="PosText" Text="0:00" FontSize="11" Foreground="#8E8E93" Typography.NumeralAlignment="Tabular"/>
        <TextBlock x:Name="DurText" Text="0:00" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Right"
                   Typography.NumeralAlignment="Tabular"/>
      </Grid>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
        <Button Style="{StaticResource Icon}" Content="&#xE892;" FontSize="16" Background="Transparent" Click="OnPrev"/>
        <Button x:Name="PlayBtn" Style="{StaticResource Icon}" Content="&#xE768;" FontSize="18" Width="46" Height="46"
                Background="White" Foreground="Black" Margin="10,0" Click="OnPlayPause"/>
        <Button Style="{StaticResource Icon}" Content="&#xE893;" FontSize="16" Background="Transparent" Click="OnNext"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
