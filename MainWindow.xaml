<Window x:Class="IslandWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:local="clr-namespace:IslandWin"
        Title="Island" Width="500" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" Foreground="White"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="Grayscale">
  <Grid>

    <!-- liquid -->
    <skia:SKElement x:Name="Goo" PaintSurface="OnPaint" IsHitTestVisible="False"/>

    <!-- compact pill content -->
    <StackPanel x:Name="PillText" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,26,0,0" Height="36" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
      <StackPanel.RenderTransform><TranslateTransform x:Name="PillShift"/></StackPanel.RenderTransform>
      <TextBlock x:Name="PillTime" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                 Typography.NumeralAlignment="Tabular"/>
      <TextBlock x:Name="PillAmPm" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93"
                 VerticalAlignment="Center" Margin="4,2,0,0"/>
    </StackPanel>

    <!-- expanded content -->
    <Grid x:Name="Panel" Width="440" Height="200" HorizontalAlignment="Center" VerticalAlignment="Top"
          Margin="0,18,0,0" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
      <Grid.RenderTransform><TranslateTransform x:Name="PanelShift"/></Grid.RenderTransform>
      <Grid.Clip><RectangleGeometry Rect="0,0,440,200" RadiusX="34" RadiusY="34"/></Grid.Clip>

      <Grid ClipToBounds="True">
        <StackPanel VerticalAlignment="Top">
          <StackPanel.RenderTransform><TranslateTransform x:Name="PageShift"/></StackPanel.RenderTransform>
          <local:ClockPage x:Name="ClockView" Height="200"/>
          <local:MusicPage x:Name="MusicView" Height="200"/>
        </StackPanel>
      </Grid>

      <!-- page indicator -->
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False">
        <Ellipse x:Name="Dot0" Width="5" Height="5" Fill="White" Margin="0,3"/>
        <Ellipse x:Name="Dot1" Width="5" Height="5" Fill="White" Opacity="0.3" Margin="0,3"/>
      </StackPanel>

      <!-- alarm / timer / reminder alert -->
      <Border x:Name="AlertLayer" Background="Black" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock x:Name="AlertTitle" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="AlertSub" FontSize="15" Foreground="#8E8E93" HorizontalAlignment="Center"
                     Margin="0,2,0,18" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="SnoozeBtn" Content="Snooze 5 min" Style="{StaticResource Pill}" Margin="0,0,10,0" Click="OnSnooze"/>
            <Button Content="Dismiss" Style="{StaticResource Pill}" Background="White" Foreground="Black" Click="OnDismiss"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</Window>
