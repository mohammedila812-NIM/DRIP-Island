<UserControl x:Class="IslandWin.ClockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>

    <DataTemplate x:Key="AlarmRow">
      <Grid Height="26" Margin="0,0,0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="Medium" VerticalAlignment="Center"
                   Typography.NumeralAlignment="Tabular"/>
        <Button Grid.Column="1" Style="{StaticResource Icon}" Content="&#xE711;" Width="24" Height="24"
                FontSize="10" Click="OnRemoveAlarm"/>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ReminderRow">
      <Grid Height="34" Margin="0,0,0,2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding When}" FontSize="11" Foreground="#8E8E93"/>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource Icon}" Content="&#xE711;" Width="24" Height="24"
                FontSize="10" Margin="8,0,0,0" Click="OnRemoveReminder"/>
      </Grid>
    </DataTemplate>

  </UserControl.Resources>

  <Grid Margin="18,14,24,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- segmented control -->
    <Border Background="#1C1C1E" CornerRadius="16" Padding="3" Height="32">
      <UniformGrid x:Name="Tabs" Rows="1">
        <RadioButton Style="{StaticResource Seg}" Content="Clock"     Tag="0" Checked="OnTab"/>
        <RadioButton Style="{StaticResource Seg}" Content="Stopwatch" Tag="1" Checked="OnTab"/>
        <RadioButton Style="{StaticResource Seg}" Content="Timer"     Tag="2" Checked="OnTab"/>
        <RadioButton Style="{StaticResource Seg}" Content="Alarm"     Tag="3" Checked="OnTab"/>
        <RadioButton Style="{StaticResource Seg}" Content="Reminder"  Tag="4" Checked="OnTab"/>
      </UniformGrid>
    </Border>

    <Grid Grid.Row="1" Margin="0,10,0,0">

      <!-- CLOCK -->
      <StackPanel x:Name="TabClock" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock HorizontalAlignment="Center" FontWeight="Light" Typography.NumeralAlignment="Tabular">
          <Run x:Name="ClkMain" FontSize="56" Text="12:00"/><Run x:Name="ClkSec" FontSize="20" Foreground="#8E8E93" Text=":00"/>
        </TextBlock>
        <TextBlock x:Name="ClkDate" HorizontalAlignment="Center" FontSize="14" Foreground="#8E8E93"/>
      </StackPanel>

      <!-- STOPWATCH -->
      <Grid x:Name="TabStop" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SwText" Text="00:00.00" FontSize="48" FontWeight="Light"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
        <TextBlock x:Name="SwLap" Grid.Row="1" Height="18" FontSize="12" Foreground="#8E8E93"
                   HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
          <Button x:Name="SwLapBtn" Content="Reset" Style="{StaticResource Pill}" Width="96" Margin="0,0,10,0" Click="OnSwLap"/>
          <Button x:Name="SwStartBtn" Content="Start" Style="{StaticResource Pill}" Width="96"
                  Background="#30D158" Foreground="Black" Click="OnSwStart"/>
        </StackPanel>
      </Grid>

      <!-- TIMER -->
      <Grid x:Name="TabTimer" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0">
          <TextBlock x:Name="TmText" Text="05:00" FontSize="46" FontWeight="Light" Typography.NumeralAlignment="Tabular"/>
          <Border Width="200" Height="4" CornerRadius="2" Background="#2C2C2E" Margin="0,4,0,10" HorizontalAlignment="Left">
            <Border x:Name="TmFill" HorizontalAlignment="Left" Width="200" CornerRadius="2" Background="White"/>
          </Border>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="TmStart" Content="Start" Style="{StaticResource Pill}" Background="#30D158"
                    Foreground="Black" Margin="0,0,8,0" Click="OnTmStart"/>
            <Button x:Name="TmCancel" Content="Cancel" Style="{StaticResource Pill}" Click="OnTmCancel"/>
          </StackPanel>
        </StackPanel>
        <UniformGrid x:Name="TmChips" Grid.Column="1" Columns="2" VerticalAlignment="Center">
          <Button Content="1 min"  Tag="1"  Style="{StaticResource Pill}" Height="28" Margin="3" Click="OnTmPreset"/>
          <Button Content="5 min"  Tag="5"  Style="{StaticResource Pill}" Height="28" Margin="3" Click="OnTmPreset"/>
          <Button Content="10 min" Tag="10" Style="{StaticResource Pill}" Height="28" Margin="3" Click="OnTmPreset"/>
          <Button Content="15 min" Tag="15" Style="{StaticResource Pill}" Height="28" Margin="3" Click="OnTmPreset"/>
          <Button Content="30 min" Tag="30" Style="{StaticResource Pill}" Height="28" Margin="3" Click="OnTmPreset"/>
          <Button Content="60 min" Tag="60" Style="{StaticResource Pill}" Height="28" Margin="3" Click="OnTmPreset"/>
        </UniformGrid>
      </Grid>

      <!-- ALARM -->
      <Grid x:Name="TabAlarm" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Width="64">
            <RepeatButton Style="{StaticResource Icon}" Content="&#xE70E;" Width="28" Height="24" FontSize="11" Background="Transparent" Click="OnHourUp"/>
            <TextBlock x:Name="AlHour" FontSize="44" FontWeight="Light" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
            <RepeatButton Style="{StaticResource Icon}" Content="&#xE70D;" Width="28" Height="24" FontSize="11" Background="Transparent" Click="OnHourDown"/>
          </StackPanel>
          <TextBlock Text=":" FontSize="40" FontWeight="Light" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,0,4"/>
          <StackPanel Width="64">
            <RepeatButton Style="{StaticResource Icon}" Content="&#xE70E;" Width="28" Height="24" FontSize="11" Background="Transparent" Click="OnMinUp"/>
            <TextBlock x:Name="AlMin" FontSize="44" FontWeight="Light" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
            <RepeatButton Style="{StaticResource Icon}" Content="&#xE70D;" Width="28" Height="24" FontSize="11" Background="Transparent" Click="OnMinDown"/>
          </StackPanel>
          <Button x:Name="AlAmPm" Style="{StaticResource Pill}" Height="30" MinWidth="52" Margin="6,0,0,0"
                  VerticalAlignment="Center" Click="OnAmPm"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="AlarmEmpty" Text="No alarms set" Foreground="#8E8E93" FontSize="13" Margin="0,0,0,10"/>
          <ItemsControl x:Name="AlarmList" ItemTemplate="{StaticResource AlarmRow}"/>
          <TextBlock x:Name="AlarmMore" FontSize="11" Foreground="#8E8E93"/>
          <Button Content="Add Alarm" Style="{StaticResource Pill}" Background="White" Foreground="Black"
                  HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnAddAlarm"/>
        </StackPanel>
      </Grid>

      <!-- REMINDER -->
      <Grid x:Name="TabReminder" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <Grid Margin="0,0,0,8">
            <TextBox x:Name="RemText" Style="{StaticResource Field}" Height="34" MaxLength="60" KeyDown="OnRemKey"/>
            <TextBlock Text="Remind me to" Foreground="#636366" FontSize="13" Margin="12,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=RemText}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton Style="{StaticResource Chip}" Content="5m"  Tag="5"  Checked="OnRemChip" Margin="0,0,6,0"/>
            <RadioButton x:Name="Rm15" Style="{StaticResource Chip}" Content="15m" Tag="15" Checked="OnRemChip" Margin="0,0,6,0"/>
            <RadioButton Style="{StaticResource Chip}" Content="30m" Tag="30" Checked="OnRemChip" Margin="0,0,6,0"/>
            <RadioButton Style="{StaticResource Chip}" Content="1h"  Tag="60" Checked="OnRemChip"/>
          </StackPanel>
          <Button Content="Add Reminder" Style="{StaticResource Pill}" Background="White" Foreground="Black"
                  HorizontalAlignment="Left" Click="OnAddReminder"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="RemEmpty" Text="No reminders" Foreground="#8E8E93" FontSize="13"/>
          <ItemsControl x:Name="RemList" ItemTemplate="{StaticResource ReminderRow}"/>
          <TextBlock x:Name="RemMore" FontSize="11" Foreground="#8E8E93"/>
        </StackPanel>
      </Grid>

    </Grid>
  </Grid>
</UserControl>
